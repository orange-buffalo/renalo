{
  "name": "renalo-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && mkdir -p dist/assets && tailwindcss -i ./src/styles.css -o ./dist/assets/styles.css --minify && bun build ./src/main.tsx --target=browser --outdir=dist --entry-naming=assets/index-[hash].[ext] --chunk-naming=assets/chunks/[name]-[hash].[ext] --asset-naming=assets/[name]-[hash].[ext] --splitting && cp src/sw.js dist/sw.js && bun ./scripts/write-index.ts",
    "check": "biome check . && tsc --noEmit",
    "format": "biome check --write .",
    "test": "bun test"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@react-stately/utils": "^3.12.1",
    "@react-types/overlays": "^3.10.0",
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "@untitledui/icons": "^0.0.22",
    "input-otp": "^1.5.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-aria": "^3.52.1",
    "react-aria-components": "^1.21.1",
    "react-dom": "19.3.0",
    "react-is": "19.3.0",
    "react-router": "8.3.1",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "streamdown": "2.6.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "type-fest": "^5.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@tailwindcss/cli": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-react-aria-components": "^2.2.0",
    "typescript": "7.0.2"
  }
}
